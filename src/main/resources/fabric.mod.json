{
	"schemaVersion": 1,
	"id": "attackrangeattribute",
	"version": "${version}",
	"name": "Attack Range Attributes",
	"description": "A small API that adds a dedicated entity attribute for attack range.",
	"authors": [
		"TheRedBrain"
	],
	"contact": {
		"sources": "https://github.com/TheRedBrain/attack-range-attribute"
	},
	"license": "MIT",
	"icon": "assets/attackrangeattribute/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.theredbrain.attackrangeattribute.AttackRangeAttribute"
		],
		"client": [
			"com.github.theredbrain.attackrangeattribute.AttackRangeAttributeClient"
		]
	},
	"mixins": [
		"attackrangeattribute.mixins.json",
		{
			"config": "attackrangeattribute.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"minecraft": "${minecraft_version}",
		"fabricloader": ">=${loader_version}",
		"java": ">=21"
	}
}